export XDG_CONFIG_HOME="$HOME/.config"

add_to_path() {
  local directory
  for directory in "$@"; do
    [[ -d "$directory" ]] || continue
    [[ ":$PATH:" == *":$directory:"* ]] || path=("$directory" $path)
  done
}

load_homebrew_shell_tools() {
  local antidote_file spaceship_file python_prefix

  if (( ! $+commands[brew] )); then
    print -u2 "Homebrew is not available; skipping Zsh plugins"
    return
  fi

  antidote_file="$(brew --prefix antidote 2>/dev/null)/share/antidote/antidote.zsh"
  if [[ -r "$antidote_file" ]]; then
    source "$antidote_file"
    antidote load "${ZDOTDIR:-$HOME}/.zsh_plugins.txt"
  else
    print -u2 "antidote is not installed; run: brew install antidote"
  fi

  spaceship_file="$(brew --prefix spaceship 2>/dev/null)/spaceship.zsh"
  if [[ -r "$spaceship_file" ]]; then
    source "$spaceship_file"
  else
    print -u2 "spaceship is not installed; run: brew install spaceship"
  fi

  python_prefix="$(brew --prefix python 2>/dev/null)"
  [[ -n "$python_prefix" ]] && add_to_path "$python_prefix/libexec/bin"
}

# Keep user-installed tools ahead of system defaults.
add_to_path /opt/homebrew/bin "$HOME/bin" "$HOME/go/bin"

# Spaceship settings must be defined before the prompt plugin is loaded.
SPACESHIP_USER_SHOW=true
SPACESHIP_CHAR_SYMBOL_ROOT="#"
load_homebrew_shell_tools

unset -f add_to_path load_homebrew_shell_tools

# Load user customizations only when Chezmoi has installed them.
[[ -r "$HOME/bin/iterm2_integration.zsh" ]] && source "$HOME/bin/iterm2_integration.zsh"
[[ -r "$HOME/.functions" ]] && source "$HOME/.functions"
[[ -r "$HOME/.aliases" ]] && source "$HOME/.aliases"

# Oh My Zsh-compatible settings used by the selected plugins.
ENABLE_CORRECTION=true
HIST_STAMPS="dd.mm.yyyy"
DISABLE_UNTRACKED_FILES_DIRTY="true"

# Enable completion files written by Oh My Zsh plugins.
if [[ -d "${ZSH_CACHE_DIR:-}/completions" ]]; then
  fpath=("$ZSH_CACHE_DIR/completions" $fpath)
fi
