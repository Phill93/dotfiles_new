[user]
	name = Daniel Bacher
	email = {{ .email }}
	signingkey = 0DE57C23EDD1CE59
[core]
  	editor = vim
	whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol	
  	excludesfile = ~/.gitignore
	pager = diff-so-fancy | less --tabs=4 -RFX
	autocrlf = input
[push]
	default = matching
[color]
	ui = auto
[gitflow "prefix"]
	feature = feature-
	release = release-
	hotfix = hotfix-
	support = support-
	versiontag = v
[credential]
    helper = cache --timeout=600
[pull]
	rebase = false
[status]
	submoduleSummary = true
[init]
	defaultBranch = default
