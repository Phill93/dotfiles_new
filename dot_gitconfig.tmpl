[user]
	name = Daniel Bacher
	email = {{ .email }}
	{{- if not (get . "server") }}
	signingkey = 0DE57C23EDD1CE59
	{{- end }}
[core]
	{{- if (get . "server") }}
	editor = vi
	{{- else }}
	editor = nvim
	{{- end }}
	whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol	
  	excludesfile = ~/.gitignore
	{{- if not (get . "server") }}
	pager = diff-so-fancy | less --tabs=4 -RFX
	{{- end }}
	autocrlf = input
[push]
	default = matching
[color]
	ui = auto
[gitflow "prefix"]
	feature = feature-
	release = release-
	hotfix = hotfix-
	support = support-
	versiontag = v
[credential]
    helper = cache --timeout=600
[pull]
	rebase = false
[status]
	submoduleSummary = true
[init]
	defaultBranch = default
